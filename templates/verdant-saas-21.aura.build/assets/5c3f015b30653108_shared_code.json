gray-100 flex flex-col h-[220px]\"\n          >\n            <div class=\"flex justify-between items-center mb-4\">\n              <h2 class=\"text-xl font-medium tracking-tight text-gray-900\">\n                Messagerie\n              </h2>\n              <div\n                class=\"w-8 h-8 rounded-full bg-[#fa3c4c] text-white flex items-center justify-center cursor-pointer hover:bg-[#e03544] transition-colors shadow-sm\"\n              >\n                <i data-lucide=\"maximize-2\" class=\"w-4 h-4\"></i>\n              </div>\n            </div>\n\n            <div\n              class=\"flex-1 flex flex-col gap-4 justify-end mb-4 overflow-hidden\"\n            >\n              <!-- Received Message -->\n              <div class=\"flex items-end gap-3\">\n                <img\n                  src=\"https://storage.googleapis.com/banani-avatars/avatar/male/35-50/European/3\"\n                  alt=\"Driver\"\n                  class=\"w-8 h-8 rounded-full object-cover shadow-sm\"\n                />\n                <div\n                  class=\"bg-gray-100 px-4 py-2.5 rounded-2xl rounded-bl-none text-sm text-gray-800 w-fit\"\n                >\n                  Salut !\n                </div>\n              </div>\n              <!-- Sent Message -->\n              <div class=\"flex items-end gap-3 justify-end\">\n                <div\n                  class=\"bg-[#fa3c4c] text-white px-4 py-2.5 rounded-2xl rounded-br-none text-sm w-fit shadow-sm\"\n                >\n                  Salut ! Quelle est ta question ?\n                </div>\n                <img\n                  src=\"https://storage.googleapis.com/banani-avatars/avatar/male/25-35/European/1\"\n                  alt=\"Me\"\n                  class=\"w-8 h-8 rounded-full object-cover shadow-sm\"\n                />\n              </div>\n            </div>\n\n            <!-- Input -->\n            <div\n              class=\"flex items-center gap-3 bg-gray-50 rounded-full px-5 py-3 border border-gray-200 mt-auto focus-within:ring-2 focus-within:ring-[#fa3c4c]/20 transition-shadow\"\n            >\n              <i\n                data-lucide=\"paperclip\"\n                class=\"w-5 h-5 text-gray-400 cursor-pointer hover:text-gray-600 transition-colors\"\n              ></i>\n              <input\n                type=\"text\"\n                placeholder=\"Message\"\n                class=\"bg-transparent border-none outline-none text-sm flex-1 min-w-0 placeholder:text-gray-400 text-gray-700\"\n              />\n              <i\n                data-lucide=\"smile\"\n                class=\"w-5 h-5 text-gray-400 cursor-pointer hover:text-gray-600 transition-colors\"\n              ></i>\n              <div\n                class=\"w-6 h-6 flex items-center justify-center ml-1 cursor-pointer\"\n              >\n                <i\n                  data-lucide=\"send\"\n                  class=\"w-5 h-5 text-gray-400 hover:text-gray-700 transition-colors\"\n                ></i>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </main>\n\n    <script>\n      lucide.createIcons();\n    </script>\n  </body>\n</html>","private":false,"user_id":"d3fc5a96-0007-4835-8f33-a87161263c1d","share_source_code":true}]